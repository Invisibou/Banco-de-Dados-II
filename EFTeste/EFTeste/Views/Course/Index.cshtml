@model ICollection<EFTeste.Models.Course>

@{
    ViewData["Title"] = "All Right Boy, keep going";
}



<div class="text-center">
    <h1 class="display-4">@Model.Count cursos.</h1>

    <a asp-controller="Create" asp-action="Course">Adicionar</a>
    <table class="table table-responsive table-hover table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Editar</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.ID</td>
                    <td>@s.Name</td>
                    <td>
                        <form asp-controller="Home" asp-action="Edit"
                              method="post">
                            <input type="hidden" name="id" value="@s.ID" />
                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Excluir
                            </button>
                        </form>
                    </td>
                    <td>
                        <a asp-controller="Home" asp-action="Update" class="btn btn-primary" asp-route-id="@s.ID">
                            Atualizar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

